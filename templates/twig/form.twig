{% if saved %}
    <p class="msg">Запись сохранена.</p>
{% endif %}

{% if errors %}
    <div class="msg">
        {% for error in errors %}
            <div>{{ error }}</div>
        {% endfor %}
    </div>
{% endif %}

<form method="post">
    <label>Заголовок</label>
    <input name="title" required minlength="3" value="{{ form.title }}">

    <label>Автор</label>
    <input name="author" required minlength="2" value="{{ form.author }}">

    <label>Категория</label>
    <select name="category">
        {% for value, label in categories %}
            <option value="{{ value }}" {% if form.category == value %}selected{% endif %}>{{ label }}</option>
        {% endfor %}
    </select>

    <label>Текст</label>
    <textarea name="text" required minlength="10">{{ form.text }}</textarea>

    <button type="submit">Сохранить</button>
</form>

